GOOGLE_API_KEY=
GEMINI_MODEL=
# Optional explicit HTTPS or owned loopback Developer API base; no ambient Vertex mode.
ONBOARDING_GEMINI_BASE_URL=
# Backend paths are relative to its current working directory.
ONBOARDING_WORKSPACE_FILE=run-output/workspace.json
ONBOARDING_WEB_ORIGIN=http://localhost:3000
# NEXT_PUBLIC value is baked at build time.
NEXT_PUBLIC_ONBOARDING_API_URL=http://localhost:8125
ONBOARDING_AGENT_URL=http://localhost:8125/agent
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
OTEL_SDK_DISABLED=true
